# Copy to .env and fill in. All settings are optional.

# Who the assistant talks with, and where they live (weather, local news, time).
BRAIN_USER_NAME=Pat
BRAIN_HOME_PLACE=Springfield, Illinois
# For the National Weather Service forecast (US only). Find yours on weather.gov.
BRAIN_HOME_LATITUDE=39.7817
BRAIN_HOME_LONGITUDE=-89.6501

# Streaming profiles it may pick (first = default) and ones it must never click.
BRAIN_PROFILES=Pat
BRAIN_BLOCKED_PROFILES=Kids

# Optional technical settings.
# BRAIN_MODEL=Qwen/Qwen3-8B-MLX-6bit
# BRAIN_VOICE=kokoro:af_heart
# BRAIN_BROWSER=safari
# BRAIN_VOICE_MATCH=0.72
# BRAIN_LLM_URL=http://127.0.0.1:8765/v1/chat/completions
